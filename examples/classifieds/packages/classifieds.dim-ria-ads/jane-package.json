{
  "schema_version": "1",
  "package_id": "classifieds.dim-ria-ads",
  "version": "1.0.1",
  "kind": "extractor",
  "title": "DIM.RIA — public property advertisements",
  "description": "Публічні картки нерухомості зі стану каталогу; без контактів продавця та приватних адрес.",
  "entry": {
    "runtime": "python",
    "module": "jane_classifieds_dimria.main",
    "callable": "extract"
  },
  "input": {
    "accepts": [
      "material"
    ],
    "media_types": [
      "text/html"
    ],
    "content_kinds": [
      "page"
    ]
  },
  "params_schema": "schemas/params.schema.json",
  "output": {
    "entities": [
      {
        "entity_type": "classified_ad",
        "schema": "schemas/classified_ad.schema.json",
        "key_fields": [
          "site",
          "listing_id"
        ]
      }
    ]
  },
  "dependencies": {
    "runtime_profile": "python-extractor@1",
    "python": []
  },
  "access": {
    "network": "none"
  },
  "tests": [
    {
      "name": "real-catalog-excerpt",
      "input": {
        "file": "tests/real-catalog/page.html",
        "media_type": "text/html",
        "url": "https://dom.ria.com/uk/arenda-kvartir/kiev/"
      },
      "expected_status": "success",
      "expected": "tests/real-catalog/expected.json",
      "compare": "exact"
    },
    {
      "name": "page-without-advertisements",
      "input": {
        "file": "tests/no-ads/page.html",
        "media_type": "text/html",
        "url": "https://dom.ria.com/uk/arenda-kvartir/kiev/"
      },
      "expected_status": "empty"
    },
    {
      "name": "currency-id-fallback",
      "input": {
        "file": "tests/currency-id-fallback/page.html",
        "media_type": "text/html",
        "url": "https://dom.ria.com/uk/arenda-kvartir/kiev/"
      },
      "expected_status": "success",
      "expected": "tests/currency-id-fallback/expected.json",
      "compare": "exact",
      "origin": "problem_sample"
    },
    {
      "name": "missing-or-unsupported-currency",
      "input": {
        "file": "tests/missing-or-unsupported-currency/page.html",
        "media_type": "text/html",
        "url": "https://dom.ria.com/uk/arenda-kvartir/kiev/"
      },
      "expected_status": "success",
      "expected": "tests/missing-or-unsupported-currency/expected.json",
      "compare": "exact",
      "origin": "problem_sample"
    }
  ],
  "provenance": {
    "created_by": "llm",
    "authors": [
      "Codex"
    ],
    "created_at": "2026-10-11T06:45:39Z",
    "change_summary": "Narrow currencyId fallback to integer IDs; retain USD/EUR/UAH mappings, omit price when currency evidence is missing or unsupported, and add regression derivatives of the real catalog fixture.",
    "based_on": {
      "package_id": "classifieds.dim-ria-ads",
      "version": "1.0.0",
      "digest": "sha256:fc6c0ea61841f8d45491b5adac18389a40b9593f754885d05ed193b120830481"
    }
  },
  "bindings_hint": {
    "source_kinds": [
      "web"
    ],
    "domains": [
      "dom.ria.com"
    ]
  }
}
