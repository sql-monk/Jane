<mxfile host="drawio" version="31.4.5">
  <diagram id="web-collector-url-pipeline" name="Web Collector: обробка одного URL">
    <mxGraphModel adaptiveColors="none" grid="1" gridSize="10" page="0" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="take" value="Взяти URL з черги&#xa;вищий пріоритет — раніше" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontSize=13;fontFamily=Helvetica;fontColor=light-dark(#1A1A1A,#E6EDF3);fillColor=light-dark(#DAE8FC,#1C3557);strokeColor=light-dark(#6C8EBF,#79A6DC);strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="300" y="20" width="260" height="56" as="geometry"/></mxCell>
        <mxCell id="robots" value="robots.txt&#xa;дозволяє?" style="rhombus;whiteSpace=wrap;html=0;fontSize=12;fontFamily=Helvetica;fontColor=light-dark(#1A1A1A,#E6EDF3);fillColor=light-dark(#F5F5F5,#2D333B);strokeColor=light-dark(#666666,#8B949E);strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="330" y="110" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="err_robots" value="Помилка access_denied_by_policy&#xa;URL пропущено" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontSize=13;fontFamily=Helvetica;fontColor=light-dark(#1A1A1A,#E6EDF3);fillColor=light-dark(#F8CECC,#4D1F1F);strokeColor=light-dark(#B85450,#E57373);strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="660" y="125" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="revisit" value="incremental:&#xa;revisit дозволяє&#xa;пропуск?" style="rhombus;whiteSpace=wrap;html=0;fontSize=12;fontFamily=Helvetica;fontColor=light-dark(#1A1A1A,#E6EDF3);fillColor=light-dark(#F5F5F5,#2D333B);strokeColor=light-dark(#666666,#8B949E);strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="320" y="235" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="unchanged" value="unchanged: збережені посилання&#xa;ідуть у recursive" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontSize=13;fontFamily=Helvetica;fontColor=light-dark(#1A1A1A,#E6EDF3);fillColor=light-dark(#F5F5F5,#2D333B);strokeColor=light-dark(#666666,#8B949E);strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="660" y="260" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="bp" value="Backpressure: чекати, доки&#xa;unacked &lt; max_unacked_materials" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontSize=13;fontFamily=Helvetica;fontColor=light-dark(#1A1A1A,#E6EDF3);fillColor=light-dark(#DAE8FC,#1C3557);strokeColor=light-dark(#6C8EBF,#79A6DC);strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="300" y="380" width="260" height="60" as="geometry"/></mxCell>
        <mxCell id="fetch" value="HTTP-запит: ліміти хоста,&#xa;кожна переадресація — scope, robots" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontSize=13;fontFamily=Helvetica;fontColor=light-dark(#1A1A1A,#E6EDF3);fillColor=light-dark(#DAE8FC,#1C3557);strokeColor=light-dark(#6C8EBF,#79A6DC);strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="285" y="475" width="290" height="60" as="geometry"/></mxCell>
        <mxCell id="err_scope" value="out_of_scope або дубль&#xa;переадресації" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontSize=13;fontFamily=Helvetica;fontColor=light-dark(#1A1A1A,#E6EDF3);fillColor=light-dark(#F8CECC,#4D1F1F);strokeColor=light-dark(#B85450,#E57373);strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="660" y="475" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="retry" value="429, 5xx&#xa;або збій мережі?" style="rhombus;whiteSpace=wrap;html=0;fontSize=12;fontFamily=Helvetica;fontColor=light-dark(#1A1A1A,#E6EDF3);fillColor=light-dark(#F5F5F5,#2D333B);strokeColor=light-dark(#666666,#8B949E);strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="330" y="570" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="backoff" value="Повтор із backoff&#xa;і Retry-After" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontSize=13;fontFamily=Helvetica;fontColor=light-dark(#1A1A1A,#E6EDF3);fillColor=light-dark(#F5F5F5,#2D333B);strokeColor=light-dark(#666666,#8B949E);strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="585" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="err_fail" value="source_unavailable або rate_limited&#xa;URL: failed, запис у /errors" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontSize=13;fontFamily=Helvetica;fontColor=light-dark(#1A1A1A,#E6EDF3);fillColor=light-dark(#F8CECC,#4D1F1F);strokeColor=light-dark(#B85450,#E57373);strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="660" y="585" width="300" height="60" as="geometry"/></mxCell>
