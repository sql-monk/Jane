{
  "site": "avtobazar",
  "group": "autos",
  "title": "Автобазар InfoCar (avtobazar.infocar.ua) — оголошення легкових авто",
  "url": "https://avtobazar.infocar.ua/car/",
  "sources": [
    {
      "source_id": "autos-avtobazar",
      "kind": "web",
      "title": "Автобазар InfoCar: нові й оновлені оголошення легкових авто",
      "description": "Заміна avtobazar.ua (домен переадресовує на новинний autocentre.ua, оголошень немає): RSS-стрічка нових і оновлених оголошень https://avtobazar.infocar.ua/rss/bazar.php → картки легкових авто /car/….",
      "locator": {
        "url": "https://avtobazar.infocar.ua/rss/bazar.php"
      },
      "collector_rules": "@pkg:autos.avtobazar-rules",
      "limits": {
        "rate": {
          "requests_per_second_per_host": 1,
          "min_delay_ms_per_host": 1000
        }
      },
      "forward_unknown_to_llm": false,
      "expected_entity_types": [
        "car_ad"
      ],
      "labels": {
        "group": "autos",
        "site": "avtobazar"
      }
    }
  ],
  "tasks": [
    {
      "task_id": "ads-avtobazar",
      "title": "Автобазар InfoCar: оголошення легкових авто щогодини",
      "description": "Щогодини: RSS-стрічка (≈300 останніх оголошень усіх категорій) читається повністю; картки легкових авто — нові, оновлені (pubDate новіший за попереднє завантаження) і раз на добу решта зі стрічки (revisit interval). RAW — у files, car_ad (ключ site + ad_id) — у PostgreSQL; повторний запуск оновлює ті самі оголошення.",
      "input": {
        "source_id": "autos-avtobazar"
      },
      "stages": [
        {
          "stage_id": "collect",
          "kind": "collect",
          "collector": {
            "collector": "web",
            "mode": "incremental"
          }
        },
        {
          "stage_id": "store-raw",
          "kind": "handler",
          "handler": "@pkg:jane.storage-files",
          "connections": {
            "target": "raw-files"
          },
          "inputs": [
            {
              "from": "collect"
            }
          ]
        },
        {
          "stage_id": "extract-ads",
          "kind": "handler",
          "handler": "@pkg:autos.avtobazar-car-ads",
          "inputs": [
            {
              "from": "collect",
              "when": {
                "field": "material.format.media_type",
                "op": "eq",
                "value": "text/html"
              }
            }
          ]
        },
        {
          "stage_id": "store-ads",
          "kind": "handler",
          "handler": "@pkg:jane.storage-postgresql",
          "connections": {
            "target": "results-pg"
          },
          "inputs": [
            {
              "from": "extract-ads",
              "select": "output",
              "when": {
                "field": "result.status",
                "op": "eq",
                "value": "success"
              }
            }
          ]
        }
      ],
      "schedule": {
        "type": "interval",
        "interval_seconds": 3600,
        "overlap": "skip"
      },
      "limits": {
        "crawl": {
          "max_depth": 1,
          "max_pages_per_run": 250,
          "revisit_interval_seconds": 86400
        }
      },
      "forward_unknown_to_llm": false,
      "labels": {
        "group": "autos",
        "site": "avtobazar"
      }
    }
  ],
  "verify": {
    "autos-avtobazar": {
      "car_ad": {
        "min": 100,
        "required": [
          "site",
          "ad_id",
          "url",
          "title",
          "price",
          "currency",
          "make",
          "model",
          "year",
          "status",
          "mileage_km",
          "region",
          "updated_at"
        ]
      }
    }
  }
}
