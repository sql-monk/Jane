{
  "schema_version": "1",
  "package_id": "catalog.prostor-product-extractor",
  "version": "2.0.0",
  "kind": "extractor",
  "title": "prostor.ua: full product cards",
  "description": "Повні картки товарів prostor.ua (косметика й побутова хімія) зі сторінок /ua/product/: назва, ціна й ціна до знижки, наявність, бренд, категорія й шлях категорій, артикул, зображення, об'єм/вага, рейтинг, кількість відгуків, характеристики (completeness: full). Ключ — shop + product_id (Magento product id). Відгуки покупців (імена) не читаються. Товар без ціни з відомим статусом «немає в наявності» зберігає метадані/наявність частково; відсутність ціни не очищує попередню ціну чи знижку. Тип сутності — група товару за розділом category_path (таблиця CATEGORY_TYPES; найдовший префікс; розділ поза таблицею — product_other).",
  "tags": [
    "catalog",
    "prostor",
    "cosmetics",
    "household",
    "products"
  ],
  "entry": {
    "runtime": "python",
    "module": "jane_sites_prostor_card.main",
    "callable": "extract"
  },
  "input": {
    "accepts": [
      "material"
    ],
    "media_types": [
      "text/html"
    ],
    "content_kinds": [
      "page"
    ]
  },
  "params_schema": "schemas/params.schema.json",
  "output": {
    "entities": [
      {
        "entity_type": "product_beauty",
        "schema": "schemas/product.schema.json",
        "key_fields": [
          "shop",
          "product_id"
        ],
        "description": "Повна картка товару prostor.ua — група «косметика, парфуми, гігієна й догляд»"
      },
      {
        "entity_type": "product_clothing",
        "schema": "schemas/product.schema.json",
        "key_fields": [
          "shop",
          "product_id"
        ],
        "description": "Повна картка товару prostor.ua — група «одяг, взуття, аксесуари, галантерея»"
      },
      {
        "entity_type": "product_food",
        "schema": "schemas/product.schema.json",
        "key_fields": [
          "shop",
          "product_id"
        ],
        "description": "Повна картка товару prostor.ua — група «продукти, напої, алкоголь»"
      },
      {
        "entity_type": "product_health",
        "schema": "schemas/product.schema.json",
        "key_fields": [
          "shop",
          "product_id"
        ],
        "description": "Повна картка товару prostor.ua — група «медичні товари, БАДи»"
      },
      {
        "entity_type": "product_home",
        "schema": "schemas/product.schema.json",
        "key_fields": [
          "shop",
          "product_id"
        ],
        "description": "Повна картка товару prostor.ua — група «дім, інтер'єр, меблі, товари для дому»"
      },
      {
        "entity_type": "product_household",
        "schema": "schemas/product.schema.json",
        "key_fields": [
          "shop",
          "product_id"
        ],
        "description": "Повна картка товару prostor.ua — група «побутова хімія»"
      },
      {
        "entity_type": "product_kids",
        "schema": "schemas/product.schema.json",
        "key_fields": [
          "shop",
          "product_id"
        ],
        "description": "Повна картка товару prostor.ua — група «іграшки, дитячий транспорт, дитячі товари»"
      },
      {
        "entity_type": "product_pet",
        "schema": "schemas/product.schema.json",
        "key_fields": [
          "shop",
          "product_id"
        ],
        "description": "Повна картка товару prostor.ua — група «зоотовари»"
      },
      {
        "entity_type": "product_sport",
        "schema": "schemas/product.schema.json",
        "key_fields": [
          "shop",
          "product_id"
        ],
        "description": "Повна картка товару prostor.ua — група «спорт і туризм»"
      },
      {
        "entity_type": "product_other",
        "schema": "schemas/product.schema.json",
        "key_fields": [
          "shop",
          "product_id"
        ],
        "description": "Повна картка товару prostor.ua — група «розділ поза таблицею (сезонні, збірні, нові розділи)»"
      }
    ]
  },
  "dependencies": {
    "runtime_profile": "python-extractor@1",
    "python": []
  },
  "access": {
    "network": "none"
  },
  "tests": [
    {
      "name": "laundry-gel-discount",
      "input": {
        "file": "tests/gel-chanteclair/page.html",
        "media_type": "text/html",
        "url": "https://prostor.ua/ua/product/chanteclair-gel-dlja-prannja-aromat-bilij-muskus-35-doz-1-575l/"
      },
      "expected_status": "success",
      "expected": "tests/gel-chanteclair/expected.json",
      "compare": "exact",
      "origin": "human"
    },
    {
