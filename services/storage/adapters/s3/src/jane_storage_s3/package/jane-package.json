{
  "schema_version": "1",
  "package_id": "jane.storage-s3",
  "version": "1.0.0",
  "kind": "storage",
  "title": "S3 storage",
  "description": "Зберігає RAW-матеріали як об'єкти, а сутності (актуальний стан та історію) і записи доставок — як JSON-документи в бакеті S3 з умовними записами (If-None-Match / If-Match). Без format.raw: вебсторінка (HTML/XHTML) — text/html байт-у-байт, будь-який інший RAW — JSON-документ Material із вбудованим вмістом; перевизначення — params.format.raw = original | html | json.",
  "tags": [
    "storage",
    "s3",
    "object-storage"
  ],
  "entry": {
    "executor": "storage",
    "adapter": "s3",
    "writes": "raw_and_entities",
    "format": {
      "entities": "json"
    },
    "history": true
  },
  "input": {
    "accepts": [
      "material",
      "entities"
    ]
  },
  "params_schema": "schemas/params.schema.json",
  "required_connections": [
    {
      "name": "target",
      "kind": "s3",
      "purpose": "бакет S3 (params.bucket, region, endpoint)"
    }
  ],
  "tests": [
    {
      "name": "raw-html-page",
      "input": {
        "file": "tests/raw-html/page.html",
        "media_type": "text/html",
        "url": "https://shop.example.test/product/a-100"
      },
      "expected_status": "success"
    },
    {
      "name": "idempotent-redelivery",
      "input": {
        "entities": "tests/redelivery/entities.json"
      },
      "expected_status": "success"
    }
  ],
  "provenance": {
    "created_by": "human",
    "authors": [
      "WP-08"
    ],
    "created_at": "2026-09-27T12:00:00Z"
  },
  "bindings_hint": {
    "source_kinds": [
      "web",
      "telegram"
    ]
  }
}
