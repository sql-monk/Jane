{
  "site": "varus",
  "group": "catalog",
  "title": "VARUS (varus.ua): супермаркет — повний каталог чотирьох категорій і оновлення цін через каталожне API сайту",
  "url": "https://varus.ua/",
  "sources": [
    {
      "source_id": "varus",
      "kind": "web",
      "title": "VARUS — інтернет-супермаркет",
      "description": "varus.ua (Vue Storefront): категорії «Йогурти», «Макаронні вироби», «Соки та нектари», «Засоби для миття посуду». Товари читаються через API, яким користуються сторінки категорій самого сайту (POST /api/graphql): HTML-сторінки категорій приходять із сервера без товарів. Запасний варіант замість NOVUS (zakaz.ua): robots.txt stores-api.zakaz.ua забороняє все (Disallow: /). robots.txt varus.ua дотримується (заборон немає); не частіше 1 запиту/с, один одночасний запит до хоста.",
      "locator": {
        "url": "https://varus.ua/"
      },
      "collector_rules": "@pkg:catalog.varus-catalog-rules",
      "limits": {
        "rate": {
          "requests_per_second_per_host": 1,
          "min_delay_ms_per_host": 1000,
          "respect_crawl_delay": true
        },
        "concurrency": {
          "max_parallel_fetches_per_host": 1
        }
      },
      "forward_unknown_to_llm": false,
      "expected_entity_types": [
        "product"
      ],
      "labels": {
        "group": "catalog",
        "site": "varus"
      }
    }
  ],
  "tasks": [
    {
      "task_id": "catalog-varus",
      "title": "varus.ua: повний каталог чотирьох категорій",
      "description": "Щоночі: списки товарів чотирьох категорій через каталожне API сайту (4 запити) → кожен товар — JSON-матеріал: RAW у raw-files, повні картки product (completeness: full) у results-pg.",
      "input": {
        "source_id": "varus"
      },
      "stages": [
        {
          "stage_id": "collect",
          "kind": "collect",
          "collector": {
            "collector": "web",
            "mode": "full"
          }
        },
        {
          "stage_id": "store-raw",
          "kind": "handler",
          "handler": "@pkg:jane.storage-files",
          "connections": {
            "target": "raw-files"
          },
          "inputs": [
            {
              "from": "collect"
            }
          ]
        },
        {
          "stage_id": "extract-products",
          "kind": "handler",
          "handler": "@pkg:catalog.varus-product-extractor",
          "params": {
            "shop": "varus"
          },
          "inputs": [
            {
              "from": "collect",
              "when": {
                "field": "material.format.media_type",
                "op": "eq",
                "value": "application/json"
              }
            }
          ]
        },
        {
          "stage_id": "store-products",
          "kind": "handler",
          "handler": "@pkg:jane.storage-postgresql",
          "connections": {
            "target": "results-pg"
          },
          "inputs": [
            {
              "from": "extract-products",
              "select": "output",
              "when": {
                "field": "result.status",
                "op": "eq",
                "value": "success"
              }
            }
          ]
        }
      ],
      "schedule": {
        "type": "cron",
        "cron": "40 2 * * *",
        "timezone": "Europe/Kyiv",
        "overlap": "skip"
      },
      "limits": {
        "crawl": {
          "max_depth": 2,
          "max_pages_per_run": 20,
          "max_bytes_per_run": 52428800,
          "max_material_bytes": 8388608,
          "max_links_per_page": 2000
        },
        "queue": {
          "max_inflight_materials": 500
        }
      },
      "forward_unknown_to_llm": false,
      "labels": {
        "group": "catalog",
        "site": "varus",
        "kind": "catalog"
      }
    },
    {
      "task_id": "prices-varus",
      "title": "varus.ua: оновлення цін і наявності",
      "description": "Кожні 4 год: короткий запит каталожного API (правила catalog.varus-prices-rules: SKU, регіональні ціни, наявність) тих самих чотирьох категорій → часткове оновлення product (price, old_price, availability; completeness: partial) тих самих ключів shop + product_id.",
      "input": {
        "source_id": "varus"
      },
      "stages": [
        {
          "stage_id": "collect",
          "kind": "collect",
          "collector": {
            "collector": "web",
            "rules": "@pkg:catalog.varus-prices-rules",
            "mode": "full"
          }
        },
        {
          "stage_id": "extract-prices",
          "kind": "handler",
          "handler": "@pkg:catalog.varus-price-extractor",
          "params": {
            "shop": "varus"
          },
          "inputs": [
            {
              "from": "collect",
              "when": {
                "field": "material.format.media_type",
                "op": "eq",
                "value": "application/json"
              }
            }
          ]
        },
        {
          "stage_id": "store-prices",
          "kind": "handler",
          "handler": "@pkg:jane.storage-postgresql",
          "connections": {
            "target": "results-pg"
          },
          "inputs": [
            {
              "from": "extract-prices",
              "select": "output",
              "when": {
                "field": "result.status",
                "op": "eq",
                "value": "success"
              }
            }
          ]
        }
      ],
      "schedule": {
        "type": "interval",
        "interval_seconds": 14400,
        "overlap": "skip"
      },
      "limits": {
        "crawl": {
          "max_depth": 2,
          "max_pages_per_run": 20,
          "max_bytes_per_run": 20971520,
          "max_material_bytes": 4194304,
          "max_links_per_page": 2000
        },
        "queue": {
          "max_inflight_materials": 500
        }
      },
      "forward_unknown_to_llm": false,
      "labels": {
        "group": "catalog",
        "site": "varus",
        "kind": "prices"
      }
    }
  ],
  "verify": {
    "varus": {
      "product": {
        "min": 800,
        "required": [
          "shop",
          "product_id",
          "title",
          "url",
          "currency",
          "availability",
          "completeness"
        ]
      }
    }
  }
}
