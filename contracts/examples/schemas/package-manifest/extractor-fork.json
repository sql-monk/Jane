{
  "schema_version": "1",
  "package_id": "acme.product-extractor",
  "version": "1.0.0",
  "kind": "extractor",
  "title": "ACME fork of Shop Example product cards",
  "entry": {
    "runtime": "python",
    "module": "product_extractor.main",
    "callable": "extract"
  },
  "output": {
