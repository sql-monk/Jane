{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "product (повна картка товару varus.ua)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "shop",
    "product_id",
    "title",
    "url",
    "currency",
    "availability",
    "completeness"
  ],
  "properties": {
    "shop": {
      "type": "string",
      "minLength": 1
    },
    "product_id": {
      "type": "string",
      "minLength": 1,
      "description": "SKU товару в магазині (як sku у JSON-LD сторінки товару)."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "format": "uri",
      "description": "Сторінка товару на сайті."
    },
    "price": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Поточна ціна (з урахуванням акції), грн."
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "old_price": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Звичайна ціна, якщо діє акційна (ціна без акції), грн."
    },
    "availability": {
      "type": "string",
      "enum": [
        "in_stock",
        "out_of_stock",
        "preorder",
        "unknown"
      ]
    },
    "brand": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "description": "Основна категорія товару."
    },
    "category_path": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Шлях категорій від розділу до основної категорії."
    },
    "image": {
      "type": "string",
      "format": "uri"
    },
    "sku": {
      "type": "string",
      "minLength": 1
    },
    "unit": {
      "type": "string",
      "enum": [
        "шт",
        "кг"
      ],
      "description": "Одиниця продажу."
    },
    "weight": {
      "type": "string",
      "minLength": 1,
      "description": "Вага нетто, наприклад «750 г»."
    },
    "volume": {
      "type": "string",
      "minLength": 1,
      "description": "Об'єм, наприклад «250 мл»."
    },
    "country": {
      "type": "string",
      "minLength": 1,
      "description": "Країна виробництва."
    },
    "attributes": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Характеристики: назва → значення."
    },
    "completeness": {
      "type": "string",
      "enum": [
        "full",
        "partial"
      ],
      "description": "full — поля повної картки (записує лише завдання каталогу)."
    }
  }
}
