{
  "schema_version": "1",
  "package_id": "catalog.varus-product-extractor",
  "version": "1.0.0",
  "kind": "extractor",
  "title": "varus.ua: full product cards from the catalog API",
  "description": "Повні картки товарів супермаркету VARUS (varus.ua) з елементів каталожного API сайту (GraphQL, той самий запит, що й сторінки категорій; кожен товар — окремий JSON-матеріал стратегії api_feed): назва, ціна й ціна без акції (регіональні ціни для відвідувача без вибраного магазину), наявність, бренд, категорія й шлях категорій, зображення, одиниця, вага/об'єм, країна виробництва, характеристики (completeness: full). Ключ — shop + product_id (SKU). Товар без ціни (немає в наявності) не надсилає price — лишається остання відома.",
  "tags": [
    "catalog",
    "varus",
    "supermarket",
    "products"
  ],
  "entry": {
    "runtime": "python",
    "module": "jane_sites_varus_product.main",
    "callable": "extract"
  },
  "input": {
    "accepts": [
      "material"
    ],
    "media_types": [
      "application/json"
    ],
    "content_kinds": [
      "json"
    ]
  },
  "params_schema": "schemas/params.schema.json",
  "output": {
    "entities": [
      {
        "entity_type": "product",
        "schema": "schemas/product.schema.json",
        "key_fields": [
          "shop",
          "product_id"
        ],
        "description": "Повна картка товару varus.ua"
      }
    ]
  },
  "dependencies": {
    "runtime_profile": "python-extractor@1",
    "python": []
  },
  "access": {
    "network": "none"
  },
  "tests": [
    {
      "name": "yogurt-on-sale",
      "input": {
        "file": "tests/yogurt-sale/item.json",
        "media_type": "application/json",
        "url": "https://varus.ua/api/yogurt-1-5-persik-yagotinskiy-ppl-750g"
      },
      "expected_status": "success",
      "expected": "tests/yogurt-sale/expected.json",
      "compare": "exact",
      "origin": "human"
    },
    {
      "name": "juice-regular-price",
      "input": {
        "file": "tests/juice-regular-price/item.json",
        "media_type": "application/json",
        "url": "https://varus.ua/api/nektar-sandora-granatovij-200-ml"
      },
      "expected_status": "success",
      "expected": "tests/juice-regular-price/expected.json",
      "compare": "exact",
      "origin": "human"
    },
    {
      "name": "dish-gel-on-sale",
      "input": {
        "file": "tests/dish-gel-sale/item.json",
        "media_type": "application/json",
        "url": "https://varus.ua/api/gel-dlya-mittya-posudu-sarmix-ultra-golden-yuzu-500-ml"
      },
      "expected_status": "success",
      "expected": "tests/dish-gel-sale/expected.json",
      "compare": "subset",
      "origin": "human"
    },
    {
      "name": "pasta-out-of-stock-without-price",
      "input": {
        "file": "tests/pasta-out-of-stock/item.json",
        "media_type": "application/json",
        "url": "https://varus.ua/api/vyroby-makaronni-origin-tofe-500-h"
      },
      "expected_status": "success",
      "expected": "tests/pasta-out-of-stock/expected.json",
      "compare": "exact",
      "origin": "human"
    },
    {
      "name": "api-error-document-empty",
      "input": {
        "file": "tests/api-error/item.json",
        "media_type": "application/json",
        "url": "https://varus.ua/api/graphql"
      },
      "expected_status": "empty",
      "origin": "human"
    },
    {
      "name": "item-without-name-unrecognized",
      "input": {
        "file": "tests/item-without-name/item.json",
        "media_type": "application/json",
        "url": "https://varus.ua/api/makaronni-virobi-golden-pasta-farfalle-400-g"
      },
      "expected_status": "unrecognized",
      "origin": "human"
    }
  ],
  "provenance": {
    "created_by": "human",
    "authors": [
      "Claude (examples/sites: varus)"
    ],
    "created_at": "2026-10-11T00:00:00Z",
    "change_summary": "Full product cards of varus.ua from the items of the site's catalog API."
  },
  "bindings_hint": {
    "source_kinds": [
      "web"
    ],
    "url_patterns": [
      "/api/*"
    ]
  }
}
