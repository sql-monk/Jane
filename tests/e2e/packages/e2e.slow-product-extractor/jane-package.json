{
  "schema_version": "1",
  "package_id": "e2e.slow-product-extractor",
  "version": "1.0.0",
  "kind": "extractor",
  "title": "E2E slow product extractor",
  "description": "Test fixture for reclaiming an orchestrator lease while the original invocation is still running.",
  "entry": {"runtime": "python", "module": "e2e_slow_products.main", "callable": "extract"},
  "input": {"accepts": ["material"], "media_types": ["text/html"], "content_kinds": ["page"]},
  "params_schema": "schemas/params.schema.json",
  "output": {
    "entities": [
      {"entity_type": "product", "schema": "schemas/product.schema.json", "key_fields": ["sku"]}
    ]
  },
  "dependencies": {"runtime_profile": "python-extractor@1", "python": []},
  "access": {"network": "none"},
  "tests": [
    {
      "name": "product",
      "input": {"file": "tests/product/page.html", "media_type": "text/html", "url": "https://testsite.example.test/product/phone-alpha"},
      "expected_status": "success",
      "expected": "tests/product/expected.json",
      "compare": "subset",
      "origin": "human"
    },
    {
      "name": "category",
      "input": {"file": "tests/category/page.html", "media_type": "text/html", "url": "https://testsite.example.test/catalog/phones/"},
      "expected_status": "empty",
      "origin": "human"
    }
  ],
  "provenance": {
    "created_by": "human",
    "authors": ["WP-13"],
    "created_at": "2026-09-30T00:00:00Z",
    "change_summary": "A configurable long invocation for the R-01 lease reclaim acceptance test."
  },
  "bindings_hint": {"source_kinds": ["web"], "url_patterns": ["/product/*"]}
}
