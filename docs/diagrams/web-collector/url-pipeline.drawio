        <mxCell id="notmod" value="304: not_modified&#xa;стан URL оновлено" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontSize=13;fontFamily=Helvetica;fontColor=light-dark(#1A1A1A,#E6EDF3);fillColor=light-dark(#F5F5F5,#2D333B);strokeColor=light-dark(#666666,#8B949E);strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="660" y="680" width="300" height="50" as="geometry"/></mxCell>
        <mxCell id="err_http" value="404/410: not_found,&#xa;інші 4xx/5xx: source_unavailable" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontSize=13;fontFamily=Helvetica;fontColor=light-dark(#1A1A1A,#E6EDF3);fillColor=light-dark(#F8CECC,#4D1F1F);strokeColor=light-dark(#B85450,#E57373);strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="660" y="755" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="dup" value="Канонічний URL&#xa;уже відомий?" style="rhombus;whiteSpace=wrap;html=0;fontSize=12;fontFamily=Helvetica;fontColor=light-dark(#1A1A1A,#E6EDF3);fillColor=light-dark(#F5F5F5,#2D333B);strokeColor=light-dark(#666666,#8B949E);strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="330" y="830" width="200" height="90" as="geometry"/></mxCell>
