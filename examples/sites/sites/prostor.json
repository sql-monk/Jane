{
  "site": "prostor",
  "group": "catalog",
  "title": "PROSTOR (prostor.ua): косметика й побутова хімія — повний каталог трьох категорій і оновлення цін",
  "url": "https://prostor.ua/",
  "sources": [
    {
      "source_id": "prostor",
      "kind": "web",
      "title": "PROSTOR — інтернет-магазин косметики й побутової хімії",
      "description": "prostor.ua (Magento 2): категорії «Зволоження і живлення» (догляд за обличчям), «Засоби для прання», «Шампуні». robots.txt дотримується; не частіше 1 запиту/с, один одночасний запит до хоста.",
      "locator": {
        "url": "https://prostor.ua/"
      },
      "collector_rules": "@pkg:catalog.prostor-catalog-rules",
      "limits": {
        "rate": {
          "requests_per_second_per_host": 1,
          "min_delay_ms_per_host": 1000,
          "respect_crawl_delay": true
        },
        "concurrency": {
          "max_parallel_fetches_per_host": 1
        }
      },
      "forward_unknown_to_llm": false,
      "expected_entity_types": [
        "product"
      ],
      "labels": {
        "group": "catalog",
        "site": "prostor"
      }
    }
  ],
  "tasks": [
    {
      "task_id": "catalog-prostor",
      "title": "prostor.ua: повний каталог трьох категорій",
      "description": "Щоночі о 01:00 (Київ): усі сторінки пагінації категорій і картки всіх товарів → RAW у raw-files, повні картки product (completeness: full) у results-pg. Збір має вкладатися в ~45 хв (обмеження job колектора — 1 год).",
      "input": {
        "source_id": "prostor"
      },
      "stages": [
        {
          "stage_id": "collect",
          "kind": "collect",
          "collector": {
            "collector": "web",
            "mode": "full"
          }
        },
        {
          "stage_id": "store-raw",
          "kind": "handler",
          "handler": "@pkg:jane.storage-files",
          "connections": {
            "target": "raw-files"
          },
          "inputs": [
            {
              "from": "collect"
            }
          ]
        },
        {
          "stage_id": "extract-products",
          "kind": "handler",
          "handler": "@pkg:catalog.prostor-product-extractor",
          "params": {
            "shop": "prostor"
          },
          "inputs": [
            {
              "from": "collect",
              "when": {
                "field": "material.format.media_type",
                "op": "eq",
                "value": "text/html"
              }
            }
          ],
          "bindings": [
            {
              "url_patterns": [
                {
                  "value": "prostor.ua/ua/product/**"
                }
              ]
            }
          ]
        },
        {
          "stage_id": "store-products",
          "kind": "handler",
          "handler": "@pkg:jane.storage-postgresql",
          "connections": {
            "target": "results-pg"
          },
          "inputs": [
            {
              "from": "extract-products",
              "select": "output",
              "when": {
                "field": "result.status",
                "op": "eq",
                "value": "success"
              }
            }
          ]
        }
      ],
      "schedule": {
        "type": "cron",
        "cron": "0 1 * * *",
        "timezone": "Europe/Kyiv",
        "overlap": "skip"
      },
      "limits": {
        "crawl": {
          "max_depth": 30,
          "max_pages_per_run": 2000
        }
      },
      "forward_unknown_to_llm": false,
      "labels": {
        "group": "catalog",
        "site": "prostor",
        "kind": "catalog"
      }
    },
    {
      "task_id": "prices-prostor",
      "title": "prostor.ua: оновлення цін і наявності зі сторінок категорій",
      "description": "Кожні 4 год удень (08:05, 12:05, 16:05, 20:05 за Києвом — не перетинається з нічним повним сканом: другу одночасну збірку того самого джерела колектор відхиляє 409): лише сторінки категорій (правила catalog.prostor-price-rules, картки не завантажуються) → часткове оновлення product (price, old_price, availability; completeness: partial) тих самих ключів shop + product_id.",
      "input": {
        "source_id": "prostor"
      },
      "stages": [
        {
          "stage_id": "collect",
          "kind": "collect",
          "collector": {
            "collector": "web",
            "rules": "@pkg:catalog.prostor-price-rules",
            "mode": "full"
          }
        },
        {
          "stage_id": "store-raw",
          "kind": "handler",
          "handler": "@pkg:jane.storage-files",
          "connections": {
            "target": "raw-files"
          },
          "inputs": [
            {
              "from": "collect"
            }
          ]
        },
        {
          "stage_id": "extract-prices",
          "kind": "handler",
          "handler": "@pkg:catalog.prostor-price-extractor",
          "params": {
            "shop": "prostor"
          },
          "inputs": [
            {
              "from": "collect",
              "when": {
                "field": "material.format.media_type",
                "op": "eq",
                "value": "text/html"
              }
            }
          ],
          "bindings": [
            {
              "url_patterns": [
                {
                  "value": "prostor.ua/ua/ukhod-za-litsom/uvlazhnenie-i-pitanie/**"
                },
                {
                  "value": "prostor.ua/ua/pobutova-himija/sredstva-dlya-stirki/**"
                },
                {
                  "value": "prostor.ua/ua/volosy/shampuni/**"
                }
              ]
            }
          ]
        },
        {
          "stage_id": "store-prices",
          "kind": "handler",
          "handler": "@pkg:jane.storage-postgresql",
          "connections": {
            "target": "results-pg"
          },
          "inputs": [
            {
              "from": "extract-prices",
              "select": "output",
              "when": {
                "field": "result.status",
                "op": "eq",
                "value": "success"
              }
            }
          ]
        }
      ],
      "schedule": {
        "type": "cron",
        "cron": "5 8,12,16,20 * * *",
        "timezone": "Europe/Kyiv",
        "overlap": "skip"
      },
      "limits": {
        "crawl": {
          "max_depth": 30,
          "max_pages_per_run": 100
        }
      },
      "forward_unknown_to_llm": false,
      "labels": {
        "group": "catalog",
        "site": "prostor",
        "kind": "prices"
      }
    }
  ],
  "verify": {
    "prostor": {
      "product": {
        "min": 600,
        "required": [
          "shop",
          "product_id",
          "title",
          "price",
          "currency",
          "url",
          "completeness"
        ]
      }
    }
  }
}
