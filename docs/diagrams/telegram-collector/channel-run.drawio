<mxfile host="drawio" version="31.4.5">
  <diagram id="telegram-collector-channel-run" name="Telegram Collector: збір одного каналу">
    <mxGraphModel adaptiveColors="none" grid="1" gridSize="10" page="0" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="resolve" value="Знайти канал&#xa;username або channel_id" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontSize=13;fontFamily=Helvetica;fontColor=light-dark(#1A1A1A,#E6EDF3);fillColor=light-dark(#DAE8FC,#1C3557);strokeColor=light-dark(#6C8EBF,#79A6DC);strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="300" y="20" width="280" height="56" as="geometry"/></mxCell>
        <mxCell id="err_ch" value="Помилка not_found для каналу,&#xa;збір іде до наступного каналу" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontSize=13;fontFamily=Helvetica;fontColor=light-dark(#1A1A1A,#E6EDF3);fillColor=light-dark(#F8CECC,#4D1F1F);strokeColor=light-dark(#B85450,#E57373);strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="680" y="20" width="320" height="56" as="geometry"/></mxCell>
        <mxCell id="plan" value="mode=full або&#xa;немає курсора?" style="rhombus;whiteSpace=wrap;html=0;fontSize=12;fontFamily=Helvetica;fontColor=light-dark(#1A1A1A,#E6EDF3);fillColor=light-dark(#F5F5F5,#2D333B);strokeColor=light-dark(#666666,#8B949E);strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="330" y="115" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="hist" value="Історія: повідомлення&#xa;після after_id, від старих" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontSize=13;fontFamily=Helvetica;fontColor=light-dark(#1A1A1A,#E6EDF3);fillColor=light-dark(#DAE8FC,#1C3557);strokeColor=light-dark(#6C8EBF,#79A6DC);strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="300" y="250" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="pts" value="Курсор має pts?" style="rhombus;whiteSpace=wrap;html=0;fontSize=12;fontFamily=Helvetica;fontColor=light-dark(#1A1A1A,#E6EDF3);fillColor=light-dark(#F5F5F5,#2D333B);strokeColor=light-dark(#666666,#8B949E);strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="340" y="345" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="changes" value="getChannelDifference&#xa;від pts курсора" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontSize=13;fontFamily=Helvetica;fontColor=light-dark(#1A1A1A,#E6EDF3);fillColor=light-dark(#DAE8FC,#1C3557);strokeColor=light-dark(#6C8EBF,#79A6DC);strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="680" y="360" width="320" height="60" as="geometry"/></mxCell>
        <mxCell id="too_long" value="Різниця завелика: помилка&#xa;source_unavailable, далі — історія" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontSize=13;fontFamily=Helvetica;fontColor=light-dark(#1A1A1A,#E6EDF3);fillColor=light-dark(#F8CECC,#4D1F1F);strokeColor=light-dark(#B85450,#E57373);strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="680" y="470" width="320" height="60" as="geometry"/></mxCell>
        <mxCell id="emit" value="Видати повідомлення:&#xa;пропустити вже бачену ревізію,&#xa;редагування — нове спостереження" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontSize=13;fontFamily=Helvetica;fontColor=light-dark(#1A1A1A,#E6EDF3);fillColor=light-dark(#DAE8FC,#1C3557);strokeColor=light-dark(#6C8EBF,#79A6DC);strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="300" y="470" width="280" height="76" as="geometry"/></mxCell>
        <mxCell id="commit" value="Одна транзакція з fence:&#xa;матеріал, tg_seen, прогрес,&#xa;курсор, stats" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontSize=13;fontFamily=Helvetica;fontColor=light-dark(#1A1A1A,#E6EDF3);fillColor=light-dark(#DAE8FC,#1C3557);strokeColor=light-dark(#6C8EBF,#79A6DC);strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="300" y="585" width="280" height="76" as="geometry"/></mxCell>
        <mxCell id="done" value="Канал готовий:&#xa;курсор pts, last_message_id" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontSize=13;fontFamily=Helvetica;fontColor=light-dark(#1A1A1A,#E6EDF3);fillColor=light-dark(#D5E8D4,#1F3D29);strokeColor=light-dark(#82B366,#7DBE6A);strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="300" y="700" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="call" value="Кожен виклик API:&#xa;пауза min_delay_ms_per_host,&#xa;тайм-аут, повтори з backoff" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontSize=13;fontFamily=Helvetica;fontColor=light-dark(#1A1A1A,#E6EDF3);fillColor=light-dark(#F5F5F5,#2D333B);strokeColor=light-dark(#666666,#8B949E);strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="800" width="300" height="76" as="geometry"/></mxCell>
        <mxCell id="flood" value="FloodWait ≤ max_flood_wait_seconds —&#xa;чекати; більше — збір failed,&#xa;rate_limited" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontSize=13;fontFamily=Helvetica;fontColor=light-dark(#1A1A1A,#E6EDF3);fillColor=light-dark(#F8CECC,#4D1F1F);strokeColor=light-dark(#B85450,#E57373);strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="360" y="800" width="320" height="76" as="geometry"/></mxCell>
        <mxCell id="transient" value="Збій після max_attempts —&#xa;збір failed, source_unavailable;&#xa;прогрес збережено" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontSize=13;fontFamily=Helvetica;fontColor=light-dark(#1A1A1A,#E6EDF3);fillColor=light-dark(#F8CECC,#4D1F1F);strokeColor=light-dark(#B85450,#E57373);strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="720" y="800" width="300" height="76" as="geometry"/></mxCell>
        <mxCell id="e1" value="недоступний" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;endSize=7;strokeWidth=1.5;strokeColor=light-dark(#424A53,#C9D1D9);fontColor=light-dark(#424A53,#C9D1D9);fontSize=12;fontFamily=Helvetica;labelBackgroundColor=light-dark(#FFFFFF,#0D1117);" edge="1" parent="1" source="resolve" target="err_ch"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e2" value="" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;endSize=7;strokeWidth=1.5;strokeColor=light-dark(#424A53,#C9D1D9);fontColor=light-dark(#424A53,#C9D1D9);fontSize=12;fontFamily=Helvetica;labelBackgroundColor=light-dark(#FFFFFF,#0D1117);" edge="1" parent="1" source="resolve" target="plan"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e3" value="так" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;endSize=7;strokeWidth=1.5;strokeColor=light-dark(#424A53,#C9D1D9);fontColor=light-dark(#424A53,#C9D1D9);fontSize=12;fontFamily=Helvetica;labelBackgroundColor=light-dark(#FFFFFF,#0D1117);" edge="1" parent="1" source="plan" target="hist"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e4" value="ні" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;endSize=7;strokeWidth=1.5;strokeColor=light-dark(#424A53,#C9D1D9);fontColor=light-dark(#424A53,#C9D1D9);fontSize=12;fontFamily=Helvetica;labelBackgroundColor=light-dark(#FFFFFF,#0D1117);exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="plan" target="pts"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="260" y="165"/><mxPoint x="260" y="390"/></Array></mxGeometry></mxCell>
        <mxCell id="e5" value="так" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;endSize=7;strokeWidth=1.5;strokeColor=light-dark(#424A53,#C9D1D9);fontColor=light-dark(#424A53,#C9D1D9);fontSize=12;fontFamily=Helvetica;labelBackgroundColor=light-dark(#FFFFFF,#0D1117);" edge="1" parent="1" source="pts" target="changes"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e6" value="ні: дочитати&#xa;історію" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;endSize=7;strokeWidth=1.5;strokeColor=light-dark(#424A53,#C9D1D9);fontColor=light-dark(#424A53,#C9D1D9);fontSize=12;fontFamily=Helvetica;labelBackgroundColor=light-dark(#FFFFFF,#0D1117);exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pts" target="hist"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="620" y="372"/><mxPoint x="620" y="280"/></Array></mxGeometry></mxCell>
