{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv *)",
      "Bash(uvx *)",
      "Bash(just *)",
      "Bash(pytest *)",
      "Bash(ruff *)",
      "Bash(mypy *)",
      "Bash(pnpm *)",
      "Bash(corepack pnpm *)",
      "Bash(docker compose *)",
      "Bash(gitleaks *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout -b *)",
      "Bash(git switch -c *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files*)",
      "Bash(git branch --show-current)",
      "Bash(git branch --list*)",
      "Bash(git branch -a)",
      "Bash(git branch -vv)",
      "Bash(git fetch origin)",
      "PowerShell(uv *)",
      "PowerShell(uvx *)",
      "PowerShell(just *)",
      "PowerShell(pytest *)",
      "PowerShell(ruff *)",
      "PowerShell(mypy *)",
      "PowerShell(pnpm *)",
      "PowerShell(corepack pnpm *)",
      "PowerShell(docker compose *)",
      "PowerShell(gitleaks *)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "PowerShell(git show*)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git checkout -b *)",
      "PowerShell(git switch -c *)",
      "PowerShell(git rev-parse *)",
      "PowerShell(git ls-files*)",
      "PowerShell(git branch --show-current)",
      "PowerShell(git branch --list*)",
      "PowerShell(git branch -a)",
      "PowerShell(git branch -vv)",
      "PowerShell(git fetch origin)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Bash(git push *main*)",
      "Bash(git push *master*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "PowerShell(git push *main*)",
      "PowerShell(git push *master*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "Bash(git branch -f*)",
      "Bash(git branch --force*)",
      "Bash(git branch -D*)",
      "Bash(git branch -d*)",
      "Bash(git branch --delete*)",
      "Bash(git branch -M*)",
      "Bash(git branch -m*)",
      "Bash(git branch --move*)",
      "Bash(git branch -C*)",
      "Bash(git branch -c*)",
      "Bash(git branch --copy*)",
      "Bash(git branch * main*)",
      "Bash(git branch * master*)",
      "Bash(git fetch *:*)",
      "Bash(git update-ref*)",
      "PowerShell(git branch -f*)",
      "PowerShell(git branch --force*)",
      "PowerShell(git branch -D*)",
      "PowerShell(git branch -d*)",
      "PowerShell(git branch --delete*)",
      "PowerShell(git branch -M*)",
      "PowerShell(git branch -m*)",
      "PowerShell(git branch --move*)",
      "PowerShell(git branch -C*)",
      "PowerShell(git branch -c*)",
      "PowerShell(git branch --copy*)",
      "PowerShell(git branch * main*)",
      "PowerShell(git branch * master*)",
      "PowerShell(git fetch *:*)",
      "PowerShell(git update-ref*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_paths.py\"",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_bash.py\"",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python \"$CLAUDE_PROJECT_DIR/.claude/hooks/scan_secrets.py\"",
            "timeout": 150
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.py\"",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_report.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_report.py\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
