  "dependencies": {"runtime_profile": "python-extractor@1", "python": []},
  "access": {"network": "none"},
  "tests": [
    {"name": "article", "input": {"file": "tests/article/page.html", "media_type": "text/html", "url": "https://news.example.test/article/1"}, "params": {"source_name": "Example", "region": "europe", "language": "en"}, "expected_status": "success"},
    {"name": "empty", "input": {"file": "tests/empty/page.html", "media_type": "text/html", "url": "https://news.example.test/"}, "params": {"source_name": "Example", "region": "europe", "language": "en"}, "expected_status": "unrecognized"}
  ],
