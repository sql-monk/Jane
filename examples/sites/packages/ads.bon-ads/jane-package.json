    ],
    "created_at": "2026-10-12T00:00:00Z",
    "based_on": {
      "package_id": "ads.bon-ads",
      "version": "1.0.1",
      "digest": "sha256:d4e886645c16dcc7919744744ffca1e76600a7f2395a114e67366456f87aea4d"
    },
    "change_summary": "2.0.0: entity type by the top-level section of the site instead of classified_ad - ad_goods, ad_realty (Нерухомість), ad_car (Транспорт), ad_other (jobs, services, animals and unknown sections); a card and a category page of one ad get the same type. A category page listing ads without its top-level section is unrecognized. Schema file renamed to schemas/ad.schema.json, fields unchanged."
  },
  "bindings_hint": {
    "source_kinds": [
      "web"
    ],
    "url_patterns": [
      "/obyavlenie/*",
      "/electronika-i-bitovaya-tehnika*",
      "/mebel-interer-obihod*"
    ]
  }
}
