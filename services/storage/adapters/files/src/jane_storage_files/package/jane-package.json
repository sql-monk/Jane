{
  "schema_version": "1",
  "package_id": "jane.storage-files",
  "version": "1.0.0",
  "kind": "storage",
  "title": "File system storage",
  "description": "Зберігає RAW-матеріали як файли (вебсторінки — HTML: формат original зберігає text/html як .html) і сутності як JSON-документи з актуальним станом та історією (ТЗ §5). Формат перевизначається параметрами етапу: format.raw = original | html | json, format.entities = json | jsonl.",
  "tags": ["storage", "filesystem"],
  "entry": {
    "executor": "storage",
    "adapter": "filesystem",
    "writes": "raw_and_entities",
    "format": {
      "raw": "original",
      "entities": "json"
    },
    "history": true
  },
  "input": {
    "accepts": ["material", "entities"]
  },
  "params_schema": "schemas/params.schema.json",
  "required_connections": [
    {
      "name": "target",
      "kind": "filesystem",
      "purpose": "каталог для RAW і результатів (params.base_path)"
    }
  ],
  "tests": [
    {
      "name": "raw-html-page",
      "input": {
        "file": "tests/raw-html/page.html",
        "media_type": "text/html",
        "url": "https://shop.example.test/product/a-100"
      },
      "expected_status": "success"
    },
    {
      "name": "idempotent-redelivery",
      "input": {
        "entities": "tests/redelivery/entities.json"
      },
      "expected_status": "success"
    }
  ],
  "provenance": {
    "created_by": "human",
    "authors": ["WP-07"],
    "created_at": "2026-09-27T08:00:00Z"
  },
  "bindings_hint": {
    "source_kinds": ["web", "telegram"]
  }
}
