{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "jane.storage-files params",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "prefix": {
      "description": "Підкаталог усередині base_path підключення (відносний, '/' як роздільник, без '..').",
      "type": "string",
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[A-Za-z0-9._/-]{1,200}$"
    },
    "format": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "raw": { "type": "string", "enum": ["original", "html", "json"] },
        "entities": { "type": "string", "enum": ["json", "jsonl"] }
      }
    }
  }
}
