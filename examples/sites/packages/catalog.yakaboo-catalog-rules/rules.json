{
  "collector": "web",
  "scope": {
    "allowed_domains": [
      "www.yakaboo.ua"
    ],
    "allowed_schemes": [
      "https"
    ],
    "path_prefixes": [
      "/ua/"
    ],
    "include": [
      {
        "value": "www.yakaboo.ua/ua/*.html"
      },
      {
        "value": "www.yakaboo.ua/ua/knigi/hudozhestvennaja-literatura/detektiv/ukrains-kij-detektiv.html**"
      },
      {
        "value": "www.yakaboo.ua/ua/knigi/hudozhestvennaja-literatura/fjentezi/ukrains-ke-fentezi.html**"
      },
      {
        "value": "www.yakaboo.ua/ua/knigi/dobirki-yakaboo/suchasni-ukrains-ki-avtori.html**"
      }
    ]
  },
  "strategies": [
    {
      "type": "listing",
      "strategy_id": "sections",
      "start_urls": [
        "https://www.yakaboo.ua/ua/knigi/hudozhestvennaja-literatura/detektiv/ukrains-kij-detektiv.html",
        "https://www.yakaboo.ua/ua/knigi/hudozhestvennaja-literatura/fjentezi/ukrains-ke-fentezi.html",
        "https://www.yakaboo.ua/ua/knigi/dobirki-yakaboo/suchasni-ukrains-ki-avtori.html"
      ],
      "item_links": {
        "value": "div.category-card a.category-card__name"
      },
      "next_page": {
        "value": "div.yb-pagination__nav-list + a.yb-pagination__nav-btn--arrow"
      }
    }
  ],
  "robots": {
    "mode": "respect"
  },
  "normalization": {
    "strip_query_params": [
      "utm_*"
    ]
  },
  "sections": [
    {
      "section_id": "categories",
      "title": "Сторінки розділів (з пагінацією ?p=N)",
      "patterns": [
        {
          "value": "www.yakaboo.ua/ua/knigi/**"
        }
      ]
    },
    {
      "section_id": "books",
      "title": "Сторінки книжок",
      "patterns": [
        {
          "value": "www.yakaboo.ua/ua/*.html"
        }
      ]
    }
  ]
}
