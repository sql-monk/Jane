{
  "schema_version": "1",
  "package_id": "catalog.bi-products",
  "version": "1.0.0",
  "kind": "extractor",
  "title": "bi.ua: product cards and category prices",
  "description": "Товари bi.ua («Будинок іграшок») зі schema.org JSON-LD: сторінка товару — повна картка (назва, ціна, стара ціна, наявність, бренд, артикул, категорії, зображення, рейтинг, характеристики, вага; completeness: full); сторінка категорії — часткове оновлення ціни, старої ціни й наявності кожного товару (completeness: partial). Ключ — магазин + код товару.",
  "tags": [
    "catalog",
    "bi-ua",
    "toys",
    "products",
    "prices",
    "json-ld"
  ],
  "entry": {
    "runtime": "python",
    "module": "jane_sites_bi_products.main",
    "callable": "extract"
  },
  "input": {
    "accepts": [
      "material"
    ],
    "media_types": [
      "text/html"
    ],
    "content_kinds": [
      "page"
    ]
  },
  "params_schema": "schemas/params.schema.json",
  "output": {
    "entities": [
      {
        "entity_type": "product",
        "schema": "schemas/product.schema.json",
        "key_fields": [
          "shop",
          "product_id"
        ],
        "description": "Товар магазину: повна картка або часткове оновлення ціни"
      }
    ]
  },
  "dependencies": {
    "runtime_profile": "python-extractor@1",
    "python": [
      "lxml>=6"
    ]
  },
  "access": {
    "network": "none"
  },
  "tests": [
    {
      "name": "product-in-stock-discount",
      "input": {
        "file": "tests/product-havoc-pink/page.html",
        "media_type": "text/html",
        "url": "https://bi.ua/ukr/product/samokat-miqilong-havoc-rozovyy-havoc-125-pink.html"
      },
      "expected_status": "success",
      "expected": "tests/product-havoc-pink/expected.json",
      "compare": "exact",
      "origin": "human"
    },
    {
      "name": "product-out-of-stock-with-reviews",
      "input": {
