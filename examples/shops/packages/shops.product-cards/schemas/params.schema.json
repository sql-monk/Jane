{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "shops.product-cards params",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entity_type"
  ],
  "properties": {
    "entity_type": {
      "description": "Тип сутності товару з таксономії product_*: за категорією, яку збирає завдання (ноутбуки — product_electronics). Обов'язковий, типового значення немає: тип визначає колекцію сховища.",
      "type": "string",
      "enum": [
        "product_food",
        "product_beauty",
        "product_household",
        "product_book",
        "product_kids",
        "product_electronics",
        "product_appliance",
        "product_tools",
        "product_garden",
        "product_home",
        "product_clothing",
        "product_auto",
        "product_pet",
        "product_sport",
        "product_office",
        "product_health",
        "product_other"
      ]
    },
    "card_class": {
      "description": "CSS-клас елемента картки товару (div з data-price).",
      "type": "string",
      "minLength": 1,
      "default": "product-card"
    },
    "currency": {
      "description": "Валюта цін data-price.",
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "default": "UAH"
    }
  }
}
