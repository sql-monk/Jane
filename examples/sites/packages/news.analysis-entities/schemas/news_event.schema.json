{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "news_event (подія / інфопривід, спільний для матеріалів різних джерел)",
  "description": "Ключ event_key = <дата за Києвом>:<клас>:<якір>; клас — strike|combat|incident|weather|diplomacy|actor; якір — код області (ua-51), коди держав (gb+ua) або нормалізований головний суб'єкт (tramp, kmda). Поля переписує останнє спостереження будь-якого джерела.",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_key", "type", "date", "anchor", "title"],
  "properties": {
    "event_key": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}:[a-z_]+:.+$" },
    "type": {
      "type": "string",
      "enum": ["strike", "combat", "incident", "weather", "diplomacy", "statement", "decision", "crime_justice", "economy", "military_aid", "humanitarian", "sports", "culture_science", "memorial", "other"]
    },
    "date": { "type": "string", "format": "date" },
    "anchor": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "region": { "type": "string" },
    "region_code": { "type": "string", "pattern": "^UA-\\d{2}$" },
    "settlement": { "type": "string" },
    "actor": { "type": "string" },
    "counterpart": { "type": "string" },
    "parties": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z]{2}$" } },
    "participants": { "type": "array", "items": { "type": "string" } },
    "last_url": { "description": "Новина, що востаннє оновила подію.", "type": "string" },
    "last_source": { "type": "string" }
  }
}
