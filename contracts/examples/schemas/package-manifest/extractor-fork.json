      {
        "entity_type": "product",
        "schema": "schemas/product.schema.json",
        "key_fields": [
          "sku"
        ]
      }
    ]
  },
  "dependencies": {
    "runtime_profile": "python-extractor@1",
    "python": [
      "selectolax>=0.3,<0.4"
    ]
  },
  "tests": [
    {
      "name": "product-a100",
      "input": {
