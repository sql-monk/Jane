{
  "collector": "web",
  "scope": {
    "allowed_domains": [
      "prostor.ua"
    ],
    "allowed_schemes": [
      "https"
    ],
    "path_prefixes": [
      "/ua/product/",
      "/sitemap.xml"
    ],
    "include": [
      {
        "type": "regex",
        "value": "^https://prostor\\.ua/ua/product/[^/?#]+/$"
      },
      {
        "type": "regex",
        "value": "^https://prostor\\.ua/sitemap\\.xml$"
      }
    ]
  },
  "strategies": [
    {
      "type": "sitemap",
      "strategy_id": "all-products",
      "urls": [
        "https://prostor.ua/sitemap.xml"
      ],
      "use_robots_txt": false,
      "use_lastmod_for_revisit": false
    }
  ],
  "robots": {
    "mode": "respect"
  },
  "normalization": {
    "strip_query_params": [
      "utm_*",
      "gclid",
      "fbclid"
    ]
  },
  "sections": [
    {
      "section_id": "products",
      "title": "Усі українські картки товарів",
      "patterns": [
        {
          "type": "regex",
          "value": "^https://prostor\\.ua/ua/product/[^/?#]+/$"
        }
      ]
    }
  ],
  "revisit": {
    "mode": "interval"
  }
}
