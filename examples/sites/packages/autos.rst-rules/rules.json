{
  "collector": "web",
  "scope": {
    "allowed_domains": [
      "rst.ua"
    ],
    "allowed_schemes": [
      "https"
    ],
    "path_prefixes": [
      "/ukr/oldcars/"
    ]
  },
  "strategies": [
    {
      "type": "listing",
      "strategy_id": "used-cars-catalog",
      "start_urls": [
        "https://rst.ua/ukr/oldcars/"
      ],
      "item_links": {
        "type": "css",
        "value": "article.car-i a.ai"
      },
      "next_page": {
        "type": "css",
        "value": "ul.pgnl li.next a"
      }
    }
  ],
  "robots": {
    "mode": "respect"
  },
  "revisit": {
    "mode": "interval"
  },
  "sections": [
    {
      "section_id": "catalog",
      "title": "Сторінки каталогу вживаних авто",
      "patterns": [
        {
          "type": "regex",
          "value": "^https://rst\\.ua/ukr/oldcars/(\\d+\\.html)?$"
        }
      ]
    },
    {
      "section_id": "ad",
      "title": "Картки оголошень",
      "patterns": [
        {
          "type": "regex",
          "value": "^https://rst\\.ua/ukr/oldcars/[^/]+/[^/]+/[^/]+_\\d+\\.html$"
        }
      ]
    }
  ],
  "dedup": {
    "use_link_rel_canonical": false
  }
}
