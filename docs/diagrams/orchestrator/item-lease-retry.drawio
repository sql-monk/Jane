        <mxCell id="v34" value="знову в черзі" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;fontColor=light-dark(#1A1A1A,#E6EDF3);" vertex="1" parent="1"><mxGeometry x="1300" y="40" width="110" height="24" as="geometry"/></mxCell>
        <mxCell id="v35" value="Захоплюється елемент запуску в running:&#xa;queued або retrying з available_at &lt;= now,&#xa;або running з простроченим lease;&#xa;живих lease в етапі &lt; max_parallel_stage_items" style="shape=note;size=14;whiteSpace=wrap;html=0;align=left;spacingLeft=8;fontSize=12;fontFamily=Helvetica;fontColor=light-dark(#1A1A1A,#E6EDF3);fillColor=light-dark(#FFFFFF,#161B22);strokeColor=light-dark(#666666,#8B949E);strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="20" y="30" width="350" height="84" as="geometry"/></mxCell>
        <mxCell id="v36" value="Збій воркера: lease спливає, інший воркер&#xa;перехоплює елемент; attempts не зростає,&#xa;lease_reclaims + 1" style="shape=note;size=14;whiteSpace=wrap;html=0;align=left;spacingLeft=8;fontSize=12;fontFamily=Helvetica;fontColor=light-dark(#1A1A1A,#E6EDF3);fillColor=light-dark(#FFFFFF,#161B22);strokeColor=light-dark(#666666,#8B949E);strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="20" y="150" width="350" height="66" as="geometry"/></mxCell>
        <mxCell id="v37" value="delivery_key = sha256(run_id | stage_id | item_key)&#xa;однаковий для всіх спроб;&#xa;обробник повертає збережений результат" style="shape=note;size=14;whiteSpace=wrap;html=0;align=left;spacingLeft=8;fontSize=12;fontFamily=Helvetica;fontColor=light-dark(#1A1A1A,#E6EDF3);fillColor=light-dark(#FFFFFF,#161B22);strokeColor=light-dark(#666666,#8B949E);strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="20" y="282" width="350" height="70" as="geometry"/></mxCell>
        <mxCell id="v38" value="backoff = initial × multiplier^(attempt − 1),&#xa;не більше max_backoff_ms; jitter до +50 %" style="shape=note;size=14;whiteSpace=wrap;html=0;align=left;spacingLeft=8;fontSize=12;fontFamily=Helvetica;fontColor=light-dark(#1A1A1A,#E6EDF3);fillColor=light-dark(#FFFFFF,#161B22);strokeColor=light-dark(#666666,#8B949E);strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="20" y="790" width="350" height="52" as="geometry"/></mxCell>
