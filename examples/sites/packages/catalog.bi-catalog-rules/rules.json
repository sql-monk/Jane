{
  "collector": "web",
  "scope": {
    "allowed_domains": [
      "bi.ua"
    ],
    "allowed_schemes": [
      "https"
    ],
    "path_prefixes": [
      "/ukr/product/",
      "/sitemap-index.xml",
      "/sitemap_product"
    ],
    "include": [
      {
        "type": "regex",
        "value": "^https://bi\\.ua/ukr/product/[^/?#]+\\.html$"
      },
      {
        "type": "regex",
        "value": "^https://bi\\.ua/(?:sitemap-index|sitemap_product(?:_[0-9]+)?)\\.xml$"
      }
    ]
  },
  "strategies": [
    {
      "type": "sitemap",
      "strategy_id": "all-products",
      "urls": [
        "https://bi.ua/sitemap-index.xml"
      ],
      "use_robots_txt": false,
      "use_lastmod_for_revisit": false
    }
  ],
  "robots": {
    "mode": "respect"
  },
  "normalization": {
    "strip_query_params": [
      "utm_*"
    ]
  },
  "sections": [
    {
      "section_id": "products",
      "title": "Усі українські картки товарів",
      "patterns": [
        {
          "type": "regex",
          "value": "^https://bi\\.ua/ukr/product/[^/?#]+\\.html$"
        }
      ]
    }
  ],
  "revisit": {
    "mode": "interval"
  }
}
