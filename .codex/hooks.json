{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python 'C:\\repos\\Jane\\.codex\\hooks\\guard_paths.py'",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python 'C:\\repos\\Jane\\.codex\\hooks\\guard_bash.py'",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python 'C:\\repos\\Jane\\.codex\\hooks\\scan_secrets.py'",
            "timeout": 150
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python 'C:\\repos\\Jane\\.codex\\hooks\\format.py'",
            "timeout": 60
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python 'C:\\repos\\Jane\\.codex\\hooks\\check_report.py'",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python 'C:\\repos\\Jane\\.codex\\hooks\\check_report.py'",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
