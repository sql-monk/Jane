{
  "collector": "web",
  "scope": {
    "allowed_domains": [
      "shafa.ua"
    ],
    "allowed_schemes": [
      "https"
    ],
    "include": [
      {"value": "shafa.ua/"},
      {"value": "shafa.ua/uk/"}
    ]
  },
  "strategies": [
