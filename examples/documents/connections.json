{
  "connections": [
    {
      "connection_id": "raw-files",
      "kind": "filesystem",
      "title": "Приклади: RAW на томі storage",
      "params": {
        "base_path": "/var/lib/jane/storage"
      }
    },
    {
      "connection_id": "results-mongo",
      "kind": "mongodb",
      "title": "Приклади: сутності в MongoDB стеку",
      "params": {
        "host": "mongodb",
        "port": 27017,
        "database": "jane_results",
        "auth_source": "admin"
      },
      "secret_refs": {
        "username": "env:JANE_SECRET_DEV_MONGO_USER",
        "password": "env:JANE_SECRET_DEV_MONGO_PASSWORD"
      }
    }
  ]
}
