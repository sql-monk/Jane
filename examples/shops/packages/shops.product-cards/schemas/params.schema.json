{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "shops.product-cards params",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "card_class": {
      "description": "CSS-клас елемента картки товару (div з data-price).",
      "type": "string",
      "minLength": 1,
      "default": "product-card"
    },
    "currency": {
      "description": "Валюта цін data-price.",
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "default": "UAH"
    }
  }
}
