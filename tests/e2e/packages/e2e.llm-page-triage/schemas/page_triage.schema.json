{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "page_triage",
  "type": "object",
  "additionalProperties": false,
  "required": ["material_id", "page_type", "summary"],
  "properties": {
    "material_id": { "type": "string", "minLength": 1 },
    "page_type": { "type": "string", "enum": ["product", "event", "job", "faq", "other"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
    "suggested_fix": { "type": "string", "maxLength": 500 }
  }
}
