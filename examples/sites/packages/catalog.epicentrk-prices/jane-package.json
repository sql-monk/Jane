        "entity_type": "product_appliance",
        "schema": "schemas/product.schema.json",
        "key_fields": [
          "shop",
          "product_id"
        ],
        "description": "Ціна й наявність товару (часткове оновлення) — група «побутова техніка»"
      },
      {
        "entity_type": "product_auto",
