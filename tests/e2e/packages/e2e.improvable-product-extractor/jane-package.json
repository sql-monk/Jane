{
  "schema_version": "1",
  "package_id": "e2e.improvable-product-extractor",
  "version": "1.0.0",
  "kind": "extractor",
  "title": "E2E fixture: product cards, in-stock offers only (to be improved)",
  "description": "Фікстура WP-13 для S-M2-07: написаний людиною вузький екстрактор тестового сайту. Картка з JSON-LD Product і availability InStock — success; інший стан пропозиції — unrecognized (сигнатура unknown-availability, часткова сутність); сторінка без JSON-LD Product — empty. Сценарій вдосконалює його через асистента (LLM — фейковий провайдер WP-10).",
  "tags": ["e2e", "products", "html"],
  "entry": {
    "runtime": "python",
    "module": "e2e_improvable_products.main",
    "callable": "extract"
  },
  "input": {
    "accepts": ["material"],
    "media_types": ["text/html"],
    "content_kinds": ["page"]
  },
  "output": {
    "entities": [
      {
        "entity_type": "product",
        "schema": "schemas/product.schema.json",
        "key_fields": ["sku"],
        "description": "Картка товару"
      }
    ]
  },
  "dependencies": {
    "runtime_profile": "python-extractor@1",
    "python": []
  },
  "access": {
    "network": "none"
  },
  "tests": [
    {
      "name": "in-stock-card",
      "input": {
        "file": "tests/in-stock-card/page.html",
        "media_type": "text/html",
        "url": "http://testsite:8080/product/phone-alpha"
      },
      "expected_status": "success",
      "expected": "tests/in-stock-card/expected.json",
      "compare": "subset",
      "origin": "human"
    },
    {
      "name": "category-page-empty",
      "input": {
        "file": "tests/category-page/page.html",
        "media_type": "text/html",
        "url": "http://testsite:8080/catalog/phones/"
      },
      "expected_status": "empty",
      "origin": "human"
    }
  ],
  "provenance": {
    "created_by": "human",
    "authors": ["WP-13"],
    "created_at": "2026-09-30T00:00:00Z",
    "change_summary": "E2E fixture for S-M2-07: a human-written extractor with a known gap."
  },
  "bindings_hint": {
    "source_kinds": ["web"],
    "url_patterns": ["/product/*"]
  }
}
