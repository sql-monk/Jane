{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "catalog.varus-price-extractor params",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "shop": {
      "description": "Ідентифікатор магазину в ключі сутності (shop + product_id).",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "default": "varus"
    },
    "currency": {
      "description": "Валюта цін API (гривня).",
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "default": "UAH"
    }
  }
}
