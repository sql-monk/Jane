{
  "site": "bi",
  "group": "catalog",
  "title": "bi.ua «Будинок іграшок»: самокати, біговели, велосипеди — каталог і ціни",
  "url": "https://bi.ua/",
  "sources": [
    {
      "source_id": "bi-ua",
      "kind": "web",
      "title": "bi.ua — Будинок іграшок",
      "description": "Інтернет-магазин дитячих товарів bi.ua: категорії «Самокати», «Біговели», «Велосипеди». Запасний сайт замість masterzoo.ua (частина запитів masterzoo.ua отримує JS-перевірку на бота).",
      "locator": {
        "url": "https://bi.ua/"
      },
      "collector_rules": "@pkg:catalog.bi-catalog-rules",
      "limits": {
        "rate": {
          "requests_per_second_per_host": 1,
          "min_delay_ms_per_host": 1000,
          "respect_crawl_delay": true
        },
        "concurrency": {
          "max_parallel_fetches_per_host": 1
        }
      },
      "forward_unknown_to_llm": false,
      "expected_entity_types": [
        "product"
      ],
      "change_policy": {
        "llm_versions": "manual_approval"
      },
      "labels": {
        "site": "bi",
        "group": "catalog"
      }
    }
  ],
  "tasks": [
    {
      "task_id": "catalog-bi",
      "title": "bi.ua: повний каталог (самокати, біговели, велосипеди)",
      "description": "Щодня о 05:00 (Київ): усі сторінки пагінації трьох категорій і всі картки товарів (~950 сторінок, ~16 хв при 1 запиті/с; ліміт 1500 сторінок) → RAW у files, повні картки товарів (completeness: full) у PostgreSQL. Сторінки категорій тут — лише навігація.",
      "input": {
        "source_id": "bi-ua"
      },
      "stages": [
        {
          "stage_id": "collect",
          "kind": "collect",
          "collector": {
            "collector": "web",
            "rules": "@pkg:catalog.bi-catalog-rules",
            "mode": "full"
          }
        },
        {
          "stage_id": "store-raw",
          "kind": "handler",
          "handler": "@pkg:jane.storage-files",
          "connections": {
            "target": "raw-files"
          },
          "inputs": [
            {
              "from": "collect"
            }
          ]
        },
        {
          "stage_id": "extract-products",
          "kind": "handler",
          "handler": "@pkg:catalog.bi-products",
          "params": {
            "listing_prices": false
          },
          "inputs": [
            {
              "from": "collect",
              "when": {
                "field": "material.format.media_type",
                "op": "eq",
                "value": "text/html"
              }
            }
          ],
          "bindings": [
            {
              "sections": [
                "categories",
                "products"
              ]
            }
          ]
        },
        {
          "stage_id": "store-products",
          "kind": "handler",
          "handler": "@pkg:jane.storage-postgresql",
          "connections": {
            "target": "results-pg"
          },
          "inputs": [
            {
              "from": "extract-products",
              "select": "output",
              "when": {
                "field": "result.status",
                "op": "eq",
                "value": "success"
              }
            }
          ]
        }
      ],
      "schedule": {
        "type": "cron",
        "cron": "0 5 * * *",
        "timezone": "Europe/Kyiv",
        "overlap": "skip"
      },
      "limits": {
        "crawl": {
          "max_depth": 40,
          "max_pages_per_run": 1500
        }
      },
      "forward_unknown_to_llm": false,
      "labels": {
        "site": "bi",
        "group": "catalog",
        "kind": "catalog"
      }
    },
    {
      "task_id": "prices-bi",
      "title": "bi.ua: ціни й наявність зі сторінок категорій",
      "description": "О 08:45, 12:45, 16:45, 20:45 (Київ; не перетинається з повним скануванням о 05:00 — колектор відмовляє другій одночасній збірці джерела): лише сторінки категорій (без карток товарів) → RAW у files, часткове оновлення price, currency, availability, old_price тих самих товарів (completeness: partial).",
      "input": {
        "source_id": "bi-ua"
      },
      "stages": [
        {
          "stage_id": "collect",
          "kind": "collect",
          "collector": {
            "collector": "web",
            "rules": "@pkg:catalog.bi-prices-rules",
            "mode": "full"
          }
        },
        {
          "stage_id": "store-raw",
          "kind": "handler",
          "handler": "@pkg:jane.storage-files",
          "connections": {
            "target": "raw-files"
          },
          "inputs": [
            {
              "from": "collect"
            }
          ]
        },
        {
          "stage_id": "extract-products",
          "kind": "handler",
          "handler": "@pkg:catalog.bi-products",
          "params": {
            "listing_prices": true
          },
          "inputs": [
            {
              "from": "collect",
              "when": {
                "field": "material.format.media_type",
                "op": "eq",
                "value": "text/html"
              }
            }
          ],
          "bindings": [
            {
              "sections": [
                "categories",
                "products"
              ]
            }
          ]
        },
        {
          "stage_id": "store-products",
          "kind": "handler",
          "handler": "@pkg:jane.storage-postgresql",
          "connections": {
            "target": "results-pg"
          },
          "inputs": [
            {
              "from": "extract-products",
              "select": "output",
              "when": {
                "field": "result.status",
                "op": "eq",
                "value": "success"
              }
            }
          ]
        }
      ],
      "schedule": {
        "type": "cron",
        "cron": "45 8,12,16,20 * * *",
        "timezone": "Europe/Kyiv",
        "overlap": "skip"
      },
      "limits": {
        "crawl": {
          "max_depth": 40,
          "max_pages_per_run": 150
        }
      },
      "forward_unknown_to_llm": false,
      "labels": {
        "site": "bi",
        "group": "catalog",
        "kind": "prices"
      }
    }
  ],
  "verify": {
    "bi-ua": {
      "product": {
        "min": 700,
        "required": [
          "shop",
          "product_id",
          "title",
          "currency",
          "url",
          "availability"
        ]
      }
    }
  }
}
