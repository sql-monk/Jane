{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LLM event extractor output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "events"
  ],
  "properties": {
    "events": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "starts_at": {
            "type": "string",
            "description": "RFC 3339 with time zone, if known"
          },
          "venue": {
            "type": "string",
            "maxLength": 300
          },
          "price": {
            "type": "string",
            "maxLength": 100
          }
        }
      }
    }
  }
}
