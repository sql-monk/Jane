{
  "schema_version": "1",
  "package_id": "catalog.epicentrk-products",
  "version": "2.0.0",
  "kind": "extractor",
  "title": "Epicentr K: full product cards",
  "description": "Повна картка товару epicentrk.ua зі сторінки товару (/ua/shop/<slug>.html): назва, ціна й стара ціна (грн), наявність, бренд, категорія й шлях категорій, код товару, одиниця, рейтинг, продавець, зображення, характеристики (completeness: full). Ключ — shop + product_id (slug URL), той самий, що й у catalog.epicentrk-prices. Тип сутності — група товару за розділом category_path (таблиця CATEGORY_TYPES; найдовший префікс; розділ поза таблицею — product_other).",
  "tags": [
    "sites",
    "catalog",
    "epicentrk",
    "products"
  ],
  "entry": {
    "runtime": "python",
    "module": "jane_sites_epicentrk_products.main",
    "callable": "extract"
  },
  "input": {
    "accepts": [
      "material"
    ],
    "media_types": [
      "text/html"
    ],
    "content_kinds": [
      "page"
    ]
  },
  "params_schema": "schemas/params.schema.json",
  "output": {
    "entities": [
      {
        "entity_type": "product_appliance",
        "schema": "schemas/product.schema.json",
        "key_fields": [
          "shop",
          "product_id"
        ],
        "description": "Повна картка товару магазину — група «побутова техніка»"
      },
      {
        "entity_type": "product_auto",
        "schema": "schemas/product.schema.json",
        "key_fields": [
          "shop",
          "product_id"
        ],
        "description": "Повна картка товару магазину — група «автотовари»"
      },
      {
        "entity_type": "product_beauty",
        "schema": "schemas/product.schema.json",
        "key_fields": [
          "shop",
          "product_id"
        ],
        "description": "Повна картка товару магазину — група «косметика, парфуми, гігієна й догляд»"
      },
      {
