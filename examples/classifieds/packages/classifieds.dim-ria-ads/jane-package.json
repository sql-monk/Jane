{
  "schema_version": "1",
  "package_id": "classifieds.dim-ria-ads",
  "version": "2.0.0",
  "kind": "extractor",
  "title": "DIM.RIA — public property advertisements",
  "description": "Публічні картки нерухомості зі стану каталогу; без контактів продавця та приватних адрес. Тип сутності фіксований — ad_realty: DIM.RIA містить лише нерухомість.",
  "entry": {
    "runtime": "python",
    "module": "jane_classifieds_dimria.main",
    "callable": "extract"
  },
  "input": {
    "accepts": [
      "material"
    ],
    "media_types": [
      "text/html"
    ],
    "content_kinds": [
      "page"
    ]
  },
  "params_schema": "schemas/params.schema.json",
  "output": {
    "entities": [
      {
        "entity_type": "ad_realty",
        "schema": "schemas/ad.schema.json",
        "key_fields": [
          "site",
          "listing_id"
        ]
      }
    ]
  },
  "dependencies": {
    "runtime_profile": "python-extractor@1",
    "python": []
  },
  "access": {
    "network": "none"
  },
  "tests": [
    {
      "name": "real-catalog-excerpt",
      "input": {
        "file": "tests/real-catalog/page.html",
        "media_type": "text/html",
        "url": "https://dom.ria.com/uk/arenda-kvartir/kiev/"
      },
      "expected_status": "success",
      "expected": "tests/real-catalog/expected.json",
      "compare": "exact"
    },
    {
      "name": "page-without-advertisements",
      "input": {
        "file": "tests/no-ads/page.html",
        "media_type": "text/html",
        "url": "https://dom.ria.com/uk/arenda-kvartir/kiev/"
      },
      "expected_status": "empty"
    },
    {
      "name": "currency-id-fallback",
      "input": {
        "file": "tests/currency-id-fallback/page.html",
        "media_type": "text/html",
        "url": "https://dom.ria.com/uk/arenda-kvartir/kiev/"
      },
      "expected_status": "success",
      "expected": "tests/currency-id-fallback/expected.json",
      "compare": "exact",
      "origin": "problem_sample"
    },
    {
      "name": "missing-or-unsupported-currency",
      "input": {
        "file": "tests/missing-or-unsupported-currency/page.html",
        "media_type": "text/html",
        "url": "https://dom.ria.com/uk/arenda-kvartir/kiev/"
      },
      "expected_status": "success",
      "expected": "tests/missing-or-unsupported-currency/expected.json",
      "compare": "exact",
      "origin": "problem_sample"
    }
  ],
  "provenance": {
    "created_by": "llm",
    "authors": [
      "Codex",
      "Claude (mongo-entities C3)"
    ],
    "created_at": "2026-10-12T00:00:00Z",
    "change_summary": "2.0.0: entity type classified_ad -> ad_realty (ad taxonomy, one MongoDB collection per type); fields, key and schema unchanged.",
    "based_on": {
      "package_id": "classifieds.dim-ria-ads",
      "version": "1.0.1",
      "digest": "sha256:d4128ad311f314e52ad1257e7fec77c47f3d23a0c39aaf7582739ffe841d950d"
    }
  },
  "bindings_hint": {
    "source_kinds": [
      "web"
    ],
    "domains": [
      "dom.ria.com"
    ]
  }
}
