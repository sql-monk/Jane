{
  "profile": "python-extractor@1",
  "description": "Python 3.12 extractors: HTML/XML/JSON parsing libraries, no network, no package installation at run time.",
  "python": "3.12",
  "base_image": "python:3.12.12-slim-bookworm",
  "sdk": { "jane-extractor-sdk": "0.1.0" },
  "libraries": {
    "beautifulsoup4": "4.15.0",
    "cssselect": "1.5.0",
    "html5lib": "1.1",
    "jmespath": "1.1.0",
    "jsonpath-ng": "1.8.0",
    "lxml": "6.1.3",
    "parsel": "1.12.0",
    "python-dateutil": "2.9.0.post0",
    "regex": "2026.9.10",
    "selectolax": "0.3.34",
    "six": "1.17.0",
    "soupsieve": "2.10",
    "typing-extensions": "4.16.0",
    "w3lib": "2.4.1",
    "webencodings": "0.6.1"
  },
  "stdlib": true,
  "network": "none",
  "image_files": {
    "dockerfile": "services/handler-runtime/sandbox/python-extractor-1/Dockerfile",
    "requirements": "services/handler-runtime/sandbox/python-extractor-1/requirements.txt"
  }
}
