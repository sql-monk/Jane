        <mxCell id="note" value="Бюджет telegram.max_messages_per_run зупиняє збір як succeeded зі stopped_by; наступний збір продовжує з курсора." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;fontColor=light-dark(#1A1A1A,#E6EDF3);" vertex="1" parent="1"><mxGeometry x="20" y="900" width="1000" height="30" as="geometry"/></mxCell>
