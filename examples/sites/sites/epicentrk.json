{
  "site": "epicentrk",
  "group": "catalog",
  "title": "Епіцентр К і маркетплейс: весь асортимент, властивості товарів і періодичні ціни",
  "url": "https://epicentrk.ua/",
  "sources": [
    {
      "source_id": "epicentrk",
      "kind": "web",
      "title": "Епіцентр К — товари для дому, ремонту й саду",
      "description": "Весь асортимент: товари для дому, ремонту, саду, спорту, одяг, продукти, техніка та всі інші товарні розділи власного магазину й маркетплейсу. Discovery: обидва повні українські product sitemap, оголошені robots.txt; регіональні SEO-сторінки та мовні дублікати не збираються. Звичайний HTTP, robots.txt дотримується, не частіше одного запиту за секунду та один одночасний запит до хоста. Картки товарів містять ціни й усі доступні характеристики.",
      "locator": {
        "url": "https://epicentrk.ua/"
      },
      "collector_rules": "@pkg:catalog.epicentrk-catalog-rules",
      "limits": {
        "rate": {
          "requests_per_second_per_host": 1,
          "min_delay_ms_per_host": 1000,
          "respect_crawl_delay": true
        },
        "concurrency": {
          "max_parallel_fetches_per_host": 1
        },
        "crawl": {
          "max_links_per_page": 60000,
          "max_frontier_size": 8000000,
          "max_material_bytes": 33554432,
          "revisit_interval_seconds": 86400
        }
      },
      "forward_unknown_to_llm": false,
      "expected_entity_types": [
        "product"
      ],
      "labels": {
        "group": "catalog",
        "site": "epicentrk"
      }
    }
  ],
  "tasks": [
    {
      "task_id": "catalog-epicentrk",
      "title": "Епіцентр К і маркетплейс: весь асортимент і періодичне оновлення цін",
      "description": "Кожні 15 хв продовжується збережена черга всіх українських товарних URL із sitemap, до 400 сторінок за запуск. Нові картки збираються до завершення первинного обходу; відомі повторно перевіряються після 24 год, фактична свіжість залежить від довжини черги. Повний обхід великого асортименту може тривати від діб до місяців; завершення визначається станом усієї черги, а не успіхом окремого запуску. Ціна, наявність і всі доступні властивості оновлюються з картки, Сутності товарів та історія змін зберігаються у PostgreSQL; повний HTML кожного циклу не накопичується. Ліміти черги й sitemap перевищують виміряний каталог; досягнення лімітів не є повнотою каталогу.",
      "input": {
        "source_id": "epicentrk"
      },
      "stages": [
        {
          "stage_id": "collect",
          "kind": "collect",
          "collector": {
            "collector": "web",
            "mode": "incremental",
            "rules": "@pkg:catalog.epicentrk-catalog-rules"
          }
        },
        {
          "stage_id": "extract-products",
          "kind": "handler",
          "handler": "@pkg:catalog.epicentrk-products",
          "inputs": [
            {
              "from": "collect",
              "when": {
                "field": "material.format.media_type",
                "op": "eq",
                "value": "text/html"
              }
            }
          ],
          "bindings": [
            {
              "sections": [
                "products"
              ]
            }
          ]
        },
        {
          "stage_id": "store-products",
          "kind": "handler",
          "handler": "@pkg:jane.storage-postgresql",
          "connections": {
            "target": "results-pg"
          },
          "inputs": [
            {
              "from": "extract-products",
              "select": "output",
              "when": {
                "field": "result.status",
                "op": "eq",
                "value": "success"
              }
            }
          ]
        }
      ],
      "schedule": {
        "type": "interval",
        "interval_seconds": 900,
        "timezone": "Europe/Kyiv",
        "overlap": "skip"
      },
      "limits": {
        "crawl": {
          "max_links_per_page": 60000,
          "max_frontier_size": 8000000,
          "max_material_bytes": 33554432,
          "revisit_interval_seconds": 86400,
          "max_depth": 40,
          "max_pages_per_run": 400,
          "max_bytes_per_run": 2147483648
        }
      },
      "forward_unknown_to_llm": false,
      "labels": {
        "group": "catalog",
        "site": "epicentrk",
        "kind": "catalog"
      }
    },
    {
      "task_id": "prices-epicentrk",
      "title": "Епіцентр К і маркетплейс: ручна перевірка цін попередньої добірки",
      "description": "Попереднє завдання для обмеженої добірки категорій залишено лише для ручної діагностики. Автоматичне оновлення цін усього асортименту виконує catalog-завдання із повними product sitemap та повторними відвідуваннями карток.",
      "input": {
        "source_id": "epicentrk"
      },
      "stages": [
        {
          "stage_id": "collect",
          "kind": "collect",
          "collector": {
            "collector": "web",
            "rules": "@pkg:catalog.epicentrk-price-rules",
            "mode": "full"
          }
        },
        {
          "stage_id": "store-raw",
          "kind": "handler",
          "handler": "@pkg:jane.storage-files",
          "connections": {
            "target": "raw-files"
          },
          "inputs": [
            {
              "from": "collect"
            }
          ]
        },
        {
          "stage_id": "extract-prices",
          "kind": "handler",
          "handler": "@pkg:catalog.epicentrk-prices",
          "inputs": [
            {
              "from": "collect",
              "when": {
                "field": "material.format.media_type",
                "op": "eq",
                "value": "text/html"
              }
            }
          ],
          "bindings": [
            {
              "sections": [
                "categories"
              ]
            }
          ]
        },
        {
          "stage_id": "store-prices",
          "kind": "handler",
          "handler": "@pkg:jane.storage-postgresql",
          "connections": {
            "target": "results-pg"
          },
          "inputs": [
            {
              "from": "extract-prices",
              "select": "output",
              "when": {
                "field": "result.status",
                "op": "eq",
                "value": "success"
              }
            }
          ]
        }
      ],
      "schedule": {
        "type": "manual",
        "overlap": "skip"
      },
      "limits": {
        "crawl": {
          "max_depth": 40,
          "max_pages_per_run": 60
        }
      },
      "forward_unknown_to_llm": false,
      "labels": {
        "group": "catalog",
        "site": "epicentrk",
        "kind": "prices"
      }
    }
  ],
  "verify": {
    "epicentrk": {
      "product": {
        "min": 1000,
        "required": [
          "shop",
          "product_id",
          "title",
          "url",
          "availability"
        ]
      }
    }
  }
}
