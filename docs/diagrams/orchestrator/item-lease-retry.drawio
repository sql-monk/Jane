<mxfile host="drawio" version="31.4.5">
  <diagram id="item-lease-retry" name="Lease і повтори елемента">
    <mxGraphModel adaptiveColors="none" grid="1" gridSize="10" page="0" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="v1" value="Захопити елемент&#xa;FOR UPDATE SKIP LOCKED, lease" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontSize=13;fontFamily=Helvetica;fontColor=light-dark(#1A1A1A,#E6EDF3);fillColor=light-dark(#E1D5E7,#3A2D4D);strokeColor=light-dark(#9673A6,#B39DDB);strokeWidth=1.5;rounded=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="400" y="40" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="v2" value="lease_reclaims &gt;&#xa;MAX_LEASE_RECLAIMS?" style="rhombus;whiteSpace=wrap;html=0;fontSize=12;fontFamily=Helvetica;fontColor=light-dark(#1A1A1A,#E6EDF3);fillColor=light-dark(#E1D5E7,#3A2D4D);strokeColor=light-dark(#9673A6,#B39DDB);strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="400" y="140" width="300" height="96" as="geometry"/></mxCell>
        <mxCell id="v3" value="failed: internal_error&#xa;(отруйний елемент)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontSize=13;fontFamily=Helvetica;fontColor=light-dark(#1A1A1A,#E6EDF3);fillColor=light-dark(#F5F5F5,#2D333B);strokeColor=light-dark(#666666,#8B949E);strokeWidth=1.5;rounded=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="790" y="158" width="260" height="60" as="geometry"/></mxCell>
        <mxCell id="v4" value="POST /v1/invocations&#xa;Idempotency-Key = delivery_key;&#xa;heartbeat продовжує lease" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontSize=13;fontFamily=Helvetica;fontColor=light-dark(#1A1A1A,#E6EDF3);fillColor=light-dark(#D5E8D4,#1F3D29);strokeColor=light-dark(#82B366,#7DBE6A);strokeWidth=1.5;rounded=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="400" y="280" width="300" height="76" as="geometry"/></mxCell>
        <mxCell id="v5" value="202 + job_id?" style="rhombus;whiteSpace=wrap;html=0;fontSize=12;fontFamily=Helvetica;fontColor=light-dark(#1A1A1A,#E6EDF3);fillColor=light-dark(#E1D5E7,#3A2D4D);strokeColor=light-dark(#9673A6,#B39DDB);strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="400" y="396" width="300" height="80" as="geometry"/></mxCell>
