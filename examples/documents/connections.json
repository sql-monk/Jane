{
  "connections": [
    {
      "connection_id": "raw-files",
      "kind": "filesystem",
      "title": "Приклади: RAW на томі storage",
      "params": {
        "base_path": "/var/lib/jane/storage"
      }
    },
    {
      "connection_id": "results-mongo",
      "kind": "mongodb",
      "title": "Приклади: сутності в MongoDB стеку",
      "params": {
        "host": "mongodb",
        "port": 27017,
        "database": "jane_results",
        "auth_source": "admin"
      },
      "secret_refs": {
        "username": "env:JANE_SECRET_DEV_MONGO_USER",
        "password": "env:JANE_SECRET_DEV_MONGO_PASSWORD"
      }
    },
    {
      "connection_id": "results-news",
      "kind": "postgresql",
      "title": "Приклади: новини й дописи в PostgreSQL стеку (реляційна схема news)",
      "params": {
        "host": "postgres",
        "port": 5432,
        "database": "jane_storage_results",
        "schema": "news",
        "sslmode": "disable",
        "layout": "news"
      },
      "secret_refs": {
        "username": "env:JANE_SECRET_DEV_PG_USER",
        "password": "env:JANE_SECRET_DEV_PG_PASSWORD"
      }
    }
  ]
}
